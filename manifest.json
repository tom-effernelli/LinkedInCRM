{
  "manifest_version": 2,
  "name": "LinkedIn Profile Notes",
  "version": "1.0.0",
  "description": "Zone de notes privée synchronisée sur chaque profil LinkedIn.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["*://www.linkedin.com/in/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "linkedin-profile-notes@example.com",
      "strict_min_version": "48.0"
    }
  }
}
