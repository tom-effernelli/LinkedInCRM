{
  "manifest_version": 3,
  "name": "LinkedIn Profile Notes",
  "version": "1.1.4",
  "description": "Private notes synced on every LinkedIn profile.",
  "author": "Me",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.linkedin.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "linkedin-notes-tool-v1@my-private-extension.com",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}