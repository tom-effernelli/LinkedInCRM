{
  "manifest_version": 3,
  "name": "LinkedIn Profile Notes",
  "version": "1.1.0",
  "description": "Private notes synced on every LinkedIn profile.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.linkedin.com/*"], 
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "linkedin-profile-notes@example.com",
      "strict_min_version": "109.0"
    }
  }
}